<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Historical Timeline Explorer</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#3B82F6',
                        secondary: '#10B981',
                        dark: '#1F2937',
                        light: '#F9FAFB',
                        accent: '#8B5CF6'
                    }
                }
            }
        }
    </script>
    <style>
        .timeline-item {
            position: relative;
            padding-left: 2rem;
        }
        
        .timeline-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 100%;
            background-color: #3B82F6;
        }
        
        .timeline-dot {
            position: absolute;
            left: -8px;
            top: 8px;
            width: 20px;
            height: 20px;
            border-radius: 50%;
            background-color: #3B82F6;
            border: 4px solid #fff;
            box-shadow: 0 0 0 2px #3B82F6;
        }
        
        .fade-in {
            animation: fadeIn 0.5s ease-in-out;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .category-btn.active {
            background-color: #3B82F6;
            color: white;
        }
        
        .event-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        
        .event-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
        }
    </style>
</head>
<body class="bg-gray-50 min-h-screen font-sans">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-10">
        <div class="container mx-auto px-4 py-4 flex justify-between items-center">
            <div class="flex items-center">
                <i class="fas fa-earth-americas text-primary text-2xl mr-2"></i>
                <h1 class="text-xl font-bold text-dark">Historical Timeline Explorer</h1>
            </div>
            
            <div class="flex items-center space-x-4">
                <div class="hidden md:flex space-x-2">
                    <button class="px-4 py-2 rounded-lg text-dark hover:bg-gray-100">Home</button>
                    <button class="px-4 py-2 rounded-lg text-dark hover:bg-gray-100">Bookmarks</button>
                    <button class="px-4 py-2 rounded-lg text-dark hover:bg-gray-100">Quiz</button>
                </div>
                <button class="bg-primary text-white px-4 py-2 rounded-lg flex items-center">
                    <i class="fas fa-user mr-2"></i> Login
                </button>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-primary to-accent text-white py-16">
        <div class="container mx-auto px-4 text-center">
            <h2 class="text-4xl font-bold mb-4">Explore Earth's History</h2>
            <p class="text-xl mb-8 max-w-2xl mx-auto">Discover significant events from the past, present, and future in an interactive timeline</p>
            
            <div class="max-w-md mx-auto relative">
                <input type="text" placeholder="Search historical events..." class="w-full py-3 px-4 rounded-full text-dark shadow-lg">
                <button class="absolute right-2 top-2 bg-primary text-white p-2 rounded-full">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </section>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
        <!-- Categories -->
        <div class="mb-8">
            <h3 class="text-2xl font-bold mb-4 text-dark">Browse by Category</h3>
            <div class="flex flex-wrap gap-2">
                <button class="category-btn active px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 transition">All</button>
                <button class="category-btn px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 transition">Ancient</button>
                <button class="category-btn px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 transition">Medieval</button>
                <button class="category-btn px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 transition">Modern</button>
                <button class="category-btn px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 transition">Future</button>
                <button class="category-btn px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 transition">Science</button>
                <button class="category-btn px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300 transition">Culture</button>
            </div>
        </div>

        <!-- Timeline Navigation -->
        <div class="mb-8 flex justify-between items-center">
            <h3 class="text-2xl font-bold text-dark">Historical Timeline</h3>
            <div class="flex space-x-2">
                <button class="px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300">
                    <i class="fas fa-filter mr-2"></i> Filter
                </button>
                <button class="px-4 py-2 rounded-lg bg-gray-200 hover:bg-gray-300">
                    <i class="fas fa-sort mr-2"></i> Sort
                </button>
            </div>
        </div>

        <!-- Timeline -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            <!-- Event Card 1 -->
            <div class="event-card bg-white rounded-xl shadow-md overflow-hidden fade-in">
                <div class="h-40 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1589652717521-10c0d092dea9?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80')">
                    <div class="bg-black bg-opacity-40 h-full flex items-end p-4">
                        <span class="bg-primary text-white px-3 py-1 rounded-full text-sm">Ancient</span>
                    </div>
                </div>
                <div class="p-4">
                    <h4 class="font-bold text-lg mb-2">Construction of the Great Pyramid of Giza</h4>
                    <p class="text-gray-600 mb-4">Built around 2560 BCE, this ancient wonder was the tallest man-made structure for over 3,800 years.</p>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-primary font-semibold">2560 BCE</span>
                        <button class="text-primary hover:text-accent">
                            <i class="far fa-bookmark"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Event Card 2 -->
            <div class="event-card bg-white rounded-xl shadow-md overflow-hidden fade-in">
                <div class="h-40 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1518638150340-f706e86654de?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80')">
                    <div class="bg-black bg-opacity-40 h-full flex items-end p-4">
                        <span class="bg-secondary text-white px-3 py-1 rounded-full text-sm">Medieval</span>
                    </div>
                </div>
                <div class="p-4">
                    <h4 class="font-bold text-lg mb-2">Signing of the Magna Carta</h4>
                    <p class="text-gray-600 mb-4">The Magna Carta was signed in 1215, establishing the principle that everyone is subject to the law.</p>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-primary font-semibold">1215 CE</span>
                        <button class="text-primary hover:text-accent">
                            <i class="far fa-bookmark"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Event Card 3 -->
            <div class="event-card bg-white rounded-xl shadow-md overflow-hidden fade-in">
                <div class="h-40 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1543722530-d2c3201371e7?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80')">
                    <div class="bg-black bg-opacity-40 h-full flex items-end p-4">
                        <span class="bg-accent text-white px-3 py-1 rounded-full text-sm">Space</span>
                    </div>
                </div>
                <div class="p-4">
                    <h4 class="font-bold text-lg mb-2">First Moon Landing</h4>
                    <p class="text-gray-600 mb-4">Apollo 11 mission landed the first humans on the Moon on July 20, 1969, with Neil Armstrong taking the first steps.</p>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-primary font-semibold">1969 CE</span>
                        <button class="text-primary hover:text-accent">
                            <i class="far fa-bookmark"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Event Card 4 -->
            <div class="event-card bg-white rounded-xl shadow-md overflow-hidden fade-in">
                <div class="h-40 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1578662996442-48f60103fc96?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80')">
                    <div class="bg-black bg-opacity-40 h-full flex items-end p-4">
                        <span class="bg-purple-500 text-white px-3 py-1 rounded-full text-sm">Future</span>
                    </div>
                </div>
                <div class="p-4">
                    <h4 class="font-bold text-lg mb-2">First Human Mission to Mars</h4>
                    <p class="text-gray-600 mb-4">Projected for the 2030s, this mission aims to establish a human presence on the Red Planet.</p>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-primary font-semibold">2030s</span>
                        <button class="text-primary hover:text-accent">
                            <i class="far fa-bookmark"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Event Card 5 -->
            <div class="event-card bg-white rounded-xl shadow-md overflow-hidden fade-in">
                <div class="h-40 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1581091226033-d5c48150dbaa?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80')">
                    <div class="bg-black bg-opacity-40 h-full flex items-end p-4">
                        <span class="bg-red-500 text-white px-3 py-1 rounded-full text-sm">Technology</span>
                    </div>
                </div>
                <div class="p-4">
                    <h4 class="font-bold text-lg mb-2">Invention of the World Wide Web</h4>
                    <p class="text-gray-600 mb-4">Tim Berners-Lee invented the World Wide Web in 1989, revolutionizing global communication.</p>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-primary font-semibold">1989 CE</span>
                        <button class="text-primary hover:text-accent">
                            <i class="far fa-bookmark"></i>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Event Card 6 -->
            <div class="event-card bg-white rounded-xl shadow-md overflow-hidden fade-in">
                <div class="h-40 bg-cover bg-center" style="background-image: url('https://images.unsplash.com/photo-1611273426858-450d8e3c9fce?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80')">
                    <div class="bg-black bg-opacity-40 h-full flex items-end p-4">
                        <span class="bg-green-500 text-white px-3 py-1 rounded-full text-sm">Environment</span>
                    </div>
                </div>
                <div class="p-4">
                    <h4 class="font-bold text-lg mb-2">Paris Climate Agreement</h4>
                    <p class="text-gray-600 mb-4">Adopted in 2015, this agreement aims to limit global warming to well below 2°C above pre-industrial levels.</p>
                    <div class="flex justify-between items-center">
                        <span class="text-sm text-primary font-semibold">2015 CE</span>
                        <button class="text-primary hover:text-accent">
                            <i class="far fa-bookmark"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Load More Button -->
        <div class="text-center mt-8">
            <button class="bg-primary text-white px-6 py-3 rounded-lg hover:bg-blue-600 transition">
                Load More Events
            </button>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-dark text-white py-8 mt-12">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div>
                    <h4 class="text-xl font-bold mb-4">Historical Timeline Explorer</h4>
                    <p class="text-gray-400">Your gateway to understanding the past, present, and future of our world.</p>
                </div>
                <div>
                    <h4 class="text-lg font-bold mb-4">Quick Links</h4>
                    <ul class="space-y-2">
                        <li><a href="#" class="text-gray-400 hover:text-white">About Us</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-white">Contact</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-white">Privacy Policy</a></li>
                        <li><a href="#" class="text-gray-400 hover:text-white">Terms of Service</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-lg font-bold mb-4">Subscribe to Updates</h4>
                    <div class="flex">
                        <input type="email" placeholder="Your email" class="px-4 py-2 rounded-l-lg text-dark w-full">
                        <button class="bg-primary px-4 py-2 rounded-r-lg">Subscribe</button>
                    </div>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-6 text-center text-gray-400">
                <p>© 2023 Historical Timeline Explorer. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script>
        // Simple interactivity
        document.addEventListener('DOMContentLoaded', function() {
            // Category buttons
            const categoryButtons = document.querySelectorAll('.category-btn');
            categoryButtons.forEach(button => {
                button.addEventListener('click', function() {
                    categoryButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    
                    // In a real app, this would filter the timeline
                    const eventCards = document.querySelectorAll('.event-card');
                    eventCards.forEach(card => {
                        card.classList.remove('fade-in');
                        setTimeout(() => card.classList.add('fade-in'), 10);
                    });
                });
            });
            
            // Bookmark buttons
            const bookmarkButtons = document.querySelectorAll('.event-card button');
            bookmarkButtons.forEach(button => {
                button.addEventListener('click', function() {
                    const icon = this.querySelector('i');
                    if (icon.classList.contains('far')) {
                        icon.classList.remove('far');
                        icon.classList.add('fas');
                        this.classList.add('text-accent');
                    } else {
                        icon.classList.remove('fas');
                        icon.classList.add('far');
                        this.classList.remove('text-accent');
                    }
                });
            });
            
            // Search functionality placeholder
            const searchInput = document.querySelector('input[type="text"]');
            const searchButton = document.querySelector('.fa-search').parentElement;
            
            searchButton.addEventListener('click', function() {
                if (searchInput.value.trim() !== '') {
                    alert(`Searching for: ${searchInput.value}`);
                    searchInput.value = '';
                }
            });
            
            searchInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter' && this.value.trim() !== '') {
                    alert(`Searching for: ${this.value}`);
                    this.value = '';
                }
            });
        });
    </script>
</body>
</html>
